
<!DOCTYPE html>
<html lang="en">


<head>
  <meta charset="UTF-8"Texcon</title>  <meta charset="UTF-8" />

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <link href="/public/css/styles.css" rel="stylesheet">
</head>

  <meta name="viewport" content="width=device-width, initial-scale=1" />



<body class="bg-light">
  <div class="container py-4">

    <!-- Header -->
    <div class="text-center mb-4">
      <div class="display-4 fw-bold texcon-red">Texcon</div>
    </div>

    <!-- Login Card -->
    <div class="card shadow-sm mx-auto card-soft" style="max-width:460px;">
      <div class="card-body p-4">

        <% if (error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <form method="POST" action="/login">

          <div class="mb-3">
            <label class="form-label">Username</label>
            <input
              class="form-control form-control-lg"
              name="username"
              autocomplete="username"
              required
            />
          </div>

          <div class="mb-3">
            <label class="form-label">Password</label>
            <input
              class="form-control form-control-lg"
              type="password"
              name="password"
              autocomplete="current-password"
              required
            />
          </div>

          <button class="btn btn-dark btn-lg w-100" type="submit">
            Login
          </button>

        </form>
      </div>
    </div>

    <!-- Footer -->
    <div class="text-center mt-4 small text-muted">
      Developed by Brian Gurtz
    </div>

  </div>
</body>
</html>
