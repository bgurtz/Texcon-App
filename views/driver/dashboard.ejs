
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Texcon Driver</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <link href="/public/css/styles.css" rel="stylesheet">
</head>

<body class="bg-light">
<div class="container py-4">

  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="texcon-red mb-0">Texcon</h3>
    <a href="/logout" class="btn btn-outline-dark btn-sm">
      Log out
    </a>
  </div>

  <!-- Driver Card -->
  <div class="card shadow-sm mb-3">
    <div class="card-body">
      <h5 class="mb-1"><%= driver.firstName %> <%= driver.lastName %></h5>
      <div class="text-muted small">
        Truck: <%= driver.truckType || "N/A" %>
        <%= driver.truckNumber ? " • #" + driver.truckNumber : "" %>
        <%= driver.trailerNumber ? " • Trailer #" + driver.trailerNumber : "" %>
        <%= driver.yard ? " • Yard: " + driver.yard : "" %>
      </div>
    </div>
  </div>

  <!-- =========================
       STATUS + ACTIONS
  ========================= -->
  <% if (driver.status && driver.status !== "active") { %>

    <div class="alert alert-danger text-center">
      Your employment status is <strong><%= driver.status %></strong>.
      You are not able to clock in.
    </div>

  <% } else if (today && today.clockIn && !today.clockOut) { %>

    <div class="alert alert-success text-center">
      Clocked in at
      <strong><%= new Date(today.clockIn).toLocaleTimeString() %></strong>
    </div>

    <button id="clockOutBtn" class="btn btn-dark btn-lg w-100 mb-3">
      Clock Out
    </button>

  <% } else if (today && today.clockOut) { %>

    <div class="alert alert-secondary text-center">
      Clocked out at
      <strong><%= new Date(today.clockOut).toLocaleTimeString() %></strong>
    </div>

    <button id="clockInBtn" class="btn btn-dark btn-lg w-100 mb-3">
      Clock In
    </button>

  <% } else { %>

    <div class="alert alert-warning text-center">
      Not clocked in
    </div>

    <button id="clockInBtn" class="btn btn-dark btn-lg w-100 mb-3">
      Clock In
    </button>

  <% } %>

  <!-- Pay Rate -->
  <div class="alert alert-light text-center">
    Current Hourly Rate:
    <strong>$<%= hourlyRate.toFixed(2) %>/hr</strong>
  </div>

  <!-- Hours -->
  <div class="row g-3 mb-3">
    <div class="col-6">
      <div class="card text-center shadow-sm">
        <div class="card-body">
          <div class="text-muted">Hours Today</div>
          <div class="display-6 fw-bold"><%= hoursToday.toFixed(2) %></div>
        </div>
      </div>
    </div>
    <div class="col-6">
      <div class="card text-center shadow-sm">
        <div class="card-body">
          <div class="text-muted">Hours This Week</div>
          <div class="display-6 fw-bold"><%= hoursWeek.toFixed(2) %></div>

          <div class="small mt-2">
            Regular: <strong><%= regularHours.toFixed(2) %></strong> hrs
            <% if (overtimeHours > 0) { %>
              <div class="text-danger">
                Overtime: <strong><%= overtimeHours.toFixed(2) %></strong> hrs
              </div>
            <% } %>
          </div>

        </div>
      </div>
    </div>
  </div>

  <!-- Pay -->
  <div class="row g-3 mb-4">
    <div class="col-4">
      <div class="card text-center shadow-sm">
        <div class="card-body">
          <div class="text-muted">Pay Today</div>
          <div class="h5 fw-bold">$<%= payToday.toFixed(2) %></div>
        </div>
      </div>
    </div>
    <div class="col-4">
      <div class="card text-center shadow-sm">
        <div class="card-body">
          <div class="text-muted">Pay This Week</div>
          <div class="h5 fw-bold">$<%= payWeek.toFixed(2) %></div>
          <% if (overtimeHours > 0) { %>
            <div class="small text-danger mt-1">
              Includes overtime (1.5×)
            </div>
          <% } %>
        </div>
      </div>
    </div>
    <div class="col-4">
      <div class="card text-center shadow-sm">
        <div class="card-body">
          <div class="text-muted">Pay YTD</div>
          <div class="h5 fw-bold">$<%= payYTD.toFixed(2) %></div>
        </div>
      </div>
    </div>
  </div>

  <!-- ✅ Weekly Timesheet Link -->
  <div class="text-center mb-4">
    <a href="/driver/timesheet/week" class="btn btn-outline-primary">
      View Weekly Timesheet
    </a>
  </div>

  <div id="clockMsg" class="text-center text-muted mt-2"></div>

</div>

<script src="/public/js/geolocate.js"></script>
</body>
</html>