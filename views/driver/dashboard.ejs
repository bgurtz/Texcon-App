<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Texcon Driver</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/public/css/styles.css" rel="stylesheet">
</head>

<body class="bg-light">
<div class="container py-4">

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="texcon-red mb-0">Texcon</h3>
    <a href="/logout" class="btn btn-outline-dark btn-sm">Log out</a>
  </div>

  <!-- Driver Info -->
  <div class="card card-soft shadow-sm mb-3">
    <div class="card-body">
      <h5 class="mb-1"><%= driver.firstName %> <%= driver.lastName %></h5>
      <div class="text-muted">
        Truck: <%= driver.truckType || "N/A" %>
        <%= driver.truckNumber ? " • #" + driver.truckNumber : "" %>
      </div>
    </div>
  </div>

  <!-- Hourly Rate -->
  <div class="alert alert-light">
    Current Hourly Rate:
    <strong>$<%= Number(hourlyRate || 0).toFixed(2) %>/hr</strong>
  </div>

  <!-- Status -->
  <% if (today && today.clockIn && !today.clockOut) { %>
    <div class="alert alert-success">
      Clocked in at
      <strong><%= new Date(today.clockIn).toLocaleTimeString() %></strong>
    </div>
  <% } else if (today && today.clockOut) { %>
    <div class="alert alert-secondary">
      Clocked out at
      <strong><%= new Date(today.clockOut).toLocaleTimeString() %></strong>
    </div>
  <% } else { %>
    <div class="alert alert-warning">
      Not clocked in
    </div>
  <% } %>

  <!-- Hours -->
  <div class="row g-3 mb-3">
    <div class="col-6">
      <div class="card card-soft shadow-sm text-center">
        <div class="card-body">
          <div class="text-muted">Hours Today</div>
          <div class="display-6 fw-bold">
            <%= Number(hoursToday || 0).toFixed(2) %>
          </div>
        </div>
      </div>
    </div>

    <div class="col-6">
      <div class="card card-soft shadow-sm text-center">
        <div class="card-body">
          <div class="text-muted">Hours This Week</div>
          <div class="display-6 fw-bold">
            <%= Number(hoursWeek || 0).toFixed(2) %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Pay -->
  <div class="row g-3 mb-4">
    <div class="col-4">
      <div class="card card-soft shadow-sm text-center">
        <div class="card-body">
          <div class="text-muted">Pay Today</div>
          <div class="h5 fw-bold">
            $<%= Number(payToday || 0).toFixed(2) %>
          </div>
        </div>
      </div>
    </div>

    <div class="col-4">
      <div class="card card-soft shadow-sm text-center">
        <div class="card-body">
          <div class="text-muted">Pay This Week</div>
          <div class="h5 fw-bold">
            $<%= Number(payWeek || 0).toFixed(2) %>
          </div>
        </div>
      </div>
    </div>

    <div class="col-4">
      <div class="card card-soft shadow-sm text-center">
        <div class="card-body">
          <div class="text-muted">Pay YTD</div>
          <div class="h5 fw-bold">
            $<%= Number(payYTD || 0).toFixed(2) %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Actions -->
  <% if (!today || !today.clockIn) { %>
    <button id="clockInBtn" class="btn btn-dark btn-lg w-100">
      Clock In
    </button>
  <% } else if (!today.clockOut) { %>
    <button id="clockOutBtn" class="btn btn-dark btn-lg w-100">
      Clock Out
    </button>
  <% } %>

  <div id="clockMsg" class="mt-3"></div>

</div>

<script src="/public/js/geolocate.js"></script>
</body>
</html>