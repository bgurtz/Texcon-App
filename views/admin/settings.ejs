
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Texcon - Settings</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/public/css/styles.css" rel="stylesheet">
</head>

<body class="bg-light">
<div class="container py-4">

  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <div class="h3 fw-bold texcon-red m-0">Texcon</div>
      <div class="text-muted">Developed by Brian Gurtz</div>
    </div>
    <a href="/admin" class="btn btn-outline-secondary btn-sm">Back</a>
  </div>

  <div class="card card-soft shadow-sm">
    <div class="card-body">
      <h5 class="mb-3">GeoFence Settings</h5>

      <div class="alert alert-info">
        Turn GeoFence <strong>OFF</strong> while testing on your computer.
        Turn it back <strong>ON</strong> after deployment.
      </div>

      <!-- ✅ THIS FORM WAS MISSING -->
      <form method="POST" action="/admin/settings">

        <div class="form-check form-switch mb-3">
          <input
            class="form-check-input"
            type="checkbox"
            id="geofenceEnabled"
            name="geofenceEnabled"
            <%= settings.geofenceEnabled ? "checked" : "" %>
          >
          <label class="form-check-label" for="geofenceEnabled">
            GeoFence Enabled
          </label>
        </div>

        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label">Center Latitude</label>
            <input
              class="form-control"
              name="centerLat"
              value="<%= settings.centerLat %>">
          </div>

          <div class="col-md-4">
            <label class="form-label">Center Longitude</label>
            <input
              class="form-control"
              name="centerLng"
              value="<%= settings.centerLng %>">
          </div>

          <div class="col-md-4">
            <label class="form-label">Radius (yards)</label>
            <input
              class="form-control"
              name="radiusYards"
              value="<%= settings.radiusYards %>">
          </div>
        </div>

        <div class="mt-4 d-flex gap-2">
          <button class="btn btn-dark" type="submit">
            Save Settings
          </button>
          <a href="/admin" class="btn btn-outline-secondary">
            Cancel
          </a>
        </div>

      </form>
      <!-- ✅ END FORM -->

    </div>
  </div>

</div>
</body>
</html>