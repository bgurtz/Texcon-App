<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Drivers</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
</head>

<body class="bg-light">
<div class="container py-4">

  <a href="/admin" class="btn btn-link p-0 mb-2">← Back</a>
  <h3>Drivers</h3>

  <!-- =====================
       ADD DRIVER
  ====================== -->
  <div class="card p-3 mb-4">
    <h5>Add Driver</h5>

    <form method="POST" action="/admin/drivers/create">
      <div class="row g-2">

        <div class="col-md-3">
          <input class="form-control" name="username" placeholder="Username" required>
        </div>

        <div class="col-md-3">
          <input class="form-control" name="password" type="password" placeholder="Password" required>
        </div>

        <div class="col-md-2">
          <input class="form-control" name="firstName" placeholder="First Name">
        </div>

        <div class="col-md-2">
          <input class="form-control" name="lastName" placeholder="Last Name">
        </div>

        <div class="col-md-2">
          <input class="form-control" name="truckNumber" placeholder="Truck #">
        </div>

        <div class="col-md-3">
          <select class="form-select" name="truckType">
            <option value="">Truck Type</option>
            <option>Bobtail</option>
            <option>Belly Dump</option>
            <option>Super Dump</option>
            <option>End Dump</option>
            <option>Oil Truck</option>
            <option>Water Truck</option>
            <option>Haul Truck</option>
          </select>
        </div>

        <div class="col-md-2">
          <input
            class="form-control"
            name="hourlyRate"
            placeholder="Hourly Rate ($)"
            type="number"
            step="0.01"
          >
        </div>

      </div>

      <button class="btn btn-dark mt-3" type="submit">
        Create Driver
      </button>
    </form>
  </div>

  <!-- =====================
       DRIVER LIST
  ====================== -->
  <table class="table table-sm table-striped">
    <thead>
      <tr>
        <th>Name</th>
        <th>Username</th>
        <th>Hourly Rate</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
      <% if (drivers && drivers.length) { %>
        <% drivers.forEach(d => { %>
          <tr>
            <td><%= d.lastName %>, <%= d.firstName %></td>
            <td><%= d.username %></td>
            <td>$<%= Number(d.hourlyRate || 0).toFixed(2) %></td>
            <td>
              <a
                href="/admin/drivers/<%= d._id %>/edit"
                class="btn btn-sm btn-outline-primary"
              >
                Edit
              </a>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="4" class="text-center text-muted">
            No drivers found
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>

</div>
</body>
</html>