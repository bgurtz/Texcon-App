<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Edit Driver</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
</head>

<body class="bg-light">
<div class="container py-4">

  <a href="/admin/drivers">&larr; Back</a>
  <h3 class="mt-2">Edit Driver</h3>

  <!-- ✅ REAL FORM -->
  <form
    method="POST"
    action="/admin/drivers/<%= driver._id %>/update"
  >

    <div class="row g-3">

      <div class="col-md-4">
        <label class="form-label">First Name</label>
        <input
          class="form-control"
          name="firstName"
          value="<%= driver.firstName %>"
        >
      </div>

      <div class="col-md-4">
        <label class="form-label">Last Name</label>
        <input
          class="form-control"
          name="lastName"
          value="<%= driver.lastName %>"
        >
      </div>

      <div class="col-md-4">
        <label class="form-label">Current Hourly Rate ($)</label>
        <input
          class="form-control"
          type="number"
          step="0.01"
          value="<%= driver.hourlyRate || 0 %>"
          disabled
        >
      </div>

    </div>

    <hr>

    <h5>Pay Rate History</h5>

    <ul class="list-group mb-3">
      <% (driver.payRates || []).forEach(p => { %>
        <li class="list-group-item d-flex justify-content-between">
          <span>
            $<%= p.rate.toFixed(2) %>/hr
            (Effective <%= p.effectiveDate.toISOString().slice(0,10) %>)
          </span>
        </li>
      <% }) %>
    </ul>

    <h6>Add New Rate / Schedule Raise</h6>

    <div class="row g-2 mb-4">
      <div class="col-md-4">
        <input
          name="newRate"
          class="form-control"
          placeholder="New Hourly Rate ($)"
          type="number"
          step="0.01"
        >
      </div>

      <div class="col-md-4">
        <input
          name="effectiveDate"
          class="form-control"
          type="date"
        >
      </div>
    </div>

    <div class="row g-3">

      <div class="col-md-4">
        <label class="form-label">Truck Type</label>
        <select class="form-select" name="truckType">
          <option value="">Truck Type</option>
          <% [
            "Bobtail",
            "Belly Dump",
            "Super Dump",
            "End Dump",
            "Oil Truck",
            "Water Truck",
            "Haul Truck"
          ].forEach(t => { %>
            <option
              value="<%= t %>"
              <%= driver.truckType === t ? "selected" : "" %>
            >
              <%= t %>
            </option>
          <% }) %>
        </select>
      </div>

      <div class="col-md-4">
        <label class="form-label">Truck #</label>
        <input
          class="form-control"
          name="truckNumber"
          value="<%= driver.truckNumber %>"
        >
      </div>

      <div class="col-md-4 d-flex align-items-center">
        <div class="form-check mt-4">
          <input
            type="checkbox"
            class="form-check-input"
            name="active"
            <%= driver.active ? "checked" : "" %>
          >
          <label class="form-check-label">Active</label>
        </div>
      </div>

    </div>

    <button class="btn btn-dark mt-4">
      Save Changes
    </button>

  </form>

</div>
</body>
</html>