
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Edit Driver</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
</head>

<body class="bg-light">
<div class="container py-4">

  <!-- Back button (OUTSIDE form) -->
  <a href="/admin/drivers" class="btn btn-link mb-3">← Back to Drivers</a>

  <h3 class="mb-3">Edit Driver</h3>

  <form method="POST" action="/admin/drivers/<%= driver._id %>/update">

    <!-- DRIVER INFO -->
    <div class="card p-3 mb-3">
      <h5>Driver Info</h5>
      <div class="row g-3">
        <div class="col-md-4">
          <label>First Name</label>
          <input name="firstName" class="form-control" value="<%= driver.firstName %>">
        </div>
        <div class="col-md-4">
          <label>Last Name</label>
          <input name="lastName" class="form-control" value="<%= driver.lastName %>">
        </div>
      </div>
    </div>

    <!-- EQUIPMENT -->
    <div class="card p-3 mb-3">
      <h5>Equipment</h5>
      <div class="row g-3">
        <div class="col-md-3">
          <label>Truck Type</label>
          <select name="truckType" class="form-select">
            <% ["","Bobtail","Belly Dump","Super Dump","End Dump","Oil Truck","Water Truck","Haul Truck"]
              .forEach(t => { %>
              <option value="<%= t %>" <%= driver.truckType === t ? "selected" : "" %>>
                <%= t || "Select Truck Type" %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="col-md-3">
          <label>Truck #</label>
          <input name="truckNumber" class="form-control" value="<%= driver.truckNumber || "" %>">
        </div>

        <div class="col-md-3">
          <label>Trailer #</label>
          <input name="trailerNumber" class="form-control" value="<%= driver.trailerNumber || "" %>">
        </div>

        <div class="col-md-3">
          <label>Yard</label>
          <input name="yard" class="form-control" value="<%= driver.yard || "" %>">
        </div>
      </div>
    </div>

    <!-- PAY -->
    <div class="card p-3 mb-3">
      <h5>Current Pay</h5>
      <label>Current Hourly Rate ($)</label>
      <input
        name="hourlyRate"
        type="number"
        step="0.01"
        class="form-control mb-2"
        value="<%= driver.hourlyRate || 0 %>"
      >
      <small class="text-muted">Changing this applies immediately</small>
    </div>

    <!-- FUTURE RAISE -->
    <div class="card p-3 mb-3">
      <h5>Schedule Raise</h5>
      <div class="row g-3">
        <div class="col-md-4">
          <input name="newRate" class="form-control" type="number" step="0.01" placeholder="New Hourly Rate">
        </div>
        <div class="col-md-4">
          <input name="effectiveDate" class="form-control" type="date">
        </div>
      </div>
    </div>

    <!-- EMPLOYMENT -->
    <div class="card p-3 mb-3">
      <h5>Employment</h5>

      <label>Status</label>
      <select name="status" class="form-select mb-2">
        <option value="active" <%= driver.status === "active" ? "selected" : "" %>>Active</option>
        <option value="resigned" <%= driver.status === "resigned" ? "selected" : "" %>>Resigned</option>
        <option value="terminated" <%= driver.status === "terminated" ? "selected" : "" %>>Terminated</option>
      </select>

      <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" name="eligibleForRehire" <%= driver.eligibleForRehire ? "checked" : "" %>>
        <label class="form-check-label">Eligible for Rehire</label>
      </div>

      <label>Admin Notes</label>
      <textarea name="driverNote" class="form-control" rows="3"><%= (driver.driverNote || "").trim() %></textarea>
    </div>

    <!-- SECURITY -->
    <div class="card p-3 mb-3">
      <h5>Reset Password</h5>
      <input name="newPassword" type="password" class="form-control" placeholder="Leave blank to keep current password">
    </div>

    <button class="btn btn-dark">Save Changes</button>

  </form>

</div>
</body>
</html>