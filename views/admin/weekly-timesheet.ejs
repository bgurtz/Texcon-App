  <title>Weekly Timesheet - All Drivers</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <style>
    @media print {
      .no-print { display: none; }
    }
    th, td {
      text-align: center;
      font-size: 0.85rem;
      vertical-align: middle;
    }
  </style>
</head>

<body class="bg-light">
<div class="container-fluid py-3">

  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Weekly Timesheet - All Drivers</h4>

    <div class="no-print">
      <a href="/admin" class="btn btn-outline-secondary me-2">
        ← Back
      </a>

      <a href="/admin/timesheet/week.csv" class="btn btn-outline-primary me-2">
        Export CSV
      </a>

      <button type="button"
              class="btn btn-secondary"
              onclick="window.print()">
        Print
      </button>
    </div>
  </div>

  <!-- Week Info -->
  <div class="mb-2">
    <strong>Week:</strong>
    <%= weekStart.toLocaleDateString() %> -
    <%= weekEnd.toLocaleDateString() %>
  </div>

  <!-- Timesheet Table -->
  <table class="table table-bordered table-sm">
    <thead class="table-light">
      <tr>
        <th>Truck</th>
        <th>Name</th>
        <% for (let i = 0; i < 7; i++) { %>
          <th>
            <%= new Date(weekStart.getTime() + (i * 86400000))
                  .toLocaleDateString(undefined, { weekday: "short" }) %>
          </th>
        <% } %>
        <th>Reg</th>
        <th>OT</th>
        <th>Total</th>
      </tr>
    </thead>

    <tbody>
      <% rows.forEach(function(r) { %>
        <tr>
          <td><%= r.driver.truckNumber || "" %></td>